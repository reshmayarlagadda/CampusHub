MONGO_URI=mongodb://localhost:27017/campusconnect
PORT=5000
FRONTEND_URL=http://localhost:5173

# Optional seeder overrides
SEED_ADMIN_EMAIL=admin@campus.com
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_NAME=Administrator

SEED_STUDENT_EMAIL=student1@campus.com
SEED_STUDENT_PASSWORD=Student@123
SEED_STUDENT_REGNO=S1001

JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=7d

# Email (Nodemailer) - set real SMTP credentials to enable sending OTPs
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your@email.com
EMAIL_PASS=your_email_password
# Some people use EMAIL_PASSWORD instead of EMAIL_PASS
EMAIL_PASSWORD=your_email_password

# Optional aliases (some deployments use SMTP_* env names)
SMTP_HOST=${EMAIL_HOST}
SMTP_PORT=${EMAIL_PORT}
SMTP_USER=${EMAIL_USER}
SMTP_PASS=${EMAIL_PASS}
SMTP_PASSWORD=${EMAIL_PASS}

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend URL
FRONTEND_URL=http://localhost:5173
